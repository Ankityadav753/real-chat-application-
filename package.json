{
  "name": "mern-chat-app-root",
  "version": "1.0.0",
  "description": "Root workspace orchestrator for MERN Chat App",
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend --legacy-peer-deps",
    "install:all": "npm run install:backend && npm run install:frontend",
    "start:backend": "npm run dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "npm run start --prefix backend",
    "test": "node tests/test_step8_cors_cookies.mjs && node tests/test_step9_regex_security.mjs"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
